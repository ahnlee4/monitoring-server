COMPOSE_PROJECT_NAME=monitoring-server

POSTGRES_DB=monitoring
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://monitor:monitor123@db:5432/monitoring

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1
COLLECTOR_TOKEN=change-me

SMS_ENABLED=false
SMS_DISCONNECT_ENABLED=true
SMS_RECOVERY_ENABLED=false
SMS_CHECK_INTERVAL_SECONDS=5
SMS_LINK_GRACE_SECONDS=30
SMS_COOLDOWN_SECONDS=600
SMS_WATCH_KEYS=0000,0002
SMS_FACTORY_NAME=Monitoring Server
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
SOLAPI_TO=

FRONTEND_PORT=4173
VITE_API_BASE=/api
VITE_WS_PATH=/ws/dashboard
VITE_ALLOWED_HOSTS=tms.theintech.co.kr

NGINX_PORT=80

COLLECTOR_DRIVER=rs485
COLLECTOR_INTERVAL_SECONDS=0
COLLECTOR_DEVICE_CODES=PRESS-01,FURNACE-01,PUMP-01
COLLECTOR_API_URL=http://backend:8000/api/ingest/telemetry
COLLECTOR_YUJIN_API_URL=http://backend:8000/api/yujin/ingest-map
COLLECTOR_PUBLISH_TELEMETRY=false
COLLECTOR_REQUEST_TIMEOUT_SECONDS=15

RS485_SERIAL_PORT=/dev/ttyUSB0
RS485_BAUDRATE=38400
RS485_COMP_QTY=8
RS485_POWER_POLL_INTERVAL_CYCLES=1
RS485_RESPONSE_TIMEOUT_SECONDS=0.35
RS485_INTER_REQUEST_DELAY_SECONDS=0.005
RS485_WRITE_REQUEST_DELAY_SECONDS=0.005
RS485_WRITE_RESPONSE_TIMEOUT_SECONDS=0.35
RS485_WRITE_VERIFY_ATTEMPTS=3
RS485_DEBUG_HEX=true
COLLECTOR_CONTROL_COMMAND_LIMIT=1
COLLECTOR_CONTROL_COMMAND_DELAY_SECONDS=0.05
COLLECTOR_CONTROL_POLL_SECONDS=0.1
COLLECTOR_SETTINGS_POLL_SECONDS=2
