COMPOSE_PROJECT_NAME=monitoring-edge

EDGE_NODE_ID=board-01
EDGE_NODE_TOKEN=replace-with-the-token-registered-on-the-server
EDGE_SERVER_URL=http://192.168.7.140:18080
EDGE_SOFTWARE_VERSION=0.1.143
EDGE_OUTBOX_MAX_ROWS=10000

RS485_SERIAL_PORT=/dev/ttyUSB0
RS485_BAUDRATE=38400
RS485_COMP_QTY=8
RS485_RESPONSE_TIMEOUT_SECONDS=0.35
RS485_INTER_REQUEST_DELAY_SECONDS=0.005
RS485_WRITE_REQUEST_DELAY_SECONDS=0.005
RS485_WRITE_RESPONSE_TIMEOUT_SECONDS=0.35
RS485_WRITE_VERIFY_ATTEMPTS=3
RS485_DEBUG_HEX=false
