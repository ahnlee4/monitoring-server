COMPOSE_PROJECT_NAME=monitoring-server

POSTGRES_DB=monitoring
POSTGRES_USER=monitor
POSTGRES_PASSWORD=replace-with-a-strong-database-password

BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.7.140:18080,https://tms.theintech.co.kr
CENTRAL_ADMIN_TOKEN=replace-with-a-long-admin-token
DEFAULT_SITE_CODE=head-office
DEFAULT_SITE_NAME=본사
DEFAULT_EDGE_CODE=board-01
DEFAULT_EDGE_NAME=보드 1
DEFAULT_EDGE_TOKEN=replace-with-a-long-board-token
# 기존 .env 호환용이며 새 설치에서는 DEFAULT_EDGE_TOKEN이 우선합니다.
COLLECTOR_TOKEN=
EDGE_OFFLINE_SECONDS=30

NGINX_PORT=8080

CENTRAL_SMS_ENABLED=false
SMS_DISCONNECT_ENABLED=true
SMS_RECOVERY_ENABLED=false
SMS_FACTORY_NAME=Monitoring Server
